# rhizome on Node (npm run local, or docker compose up). Copy to .env and fill in.
# For the Cloudflare Worker use .env.deploy.example instead.

# --- server
PORT=8787
# 127.0.0.1 keeps rhizome on this machine. The Docker image listens on 0.0.0.0.
HOST=127.0.0.1
DATA_DIR=./data
# The address people and MCP clients use. OAuth URLs are built from it. Required behind a reverse proxy.
PUBLIC_URL=http://localhost:8787
# Only when a reverse proxy sets X-Forwarded-For/-Proto/-Host and nobody can reach rhizome around it.
TRUST_PROXY=false

# --- AI: any OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM, LocalAI, OpenAI)
AI_PROVIDER=openai
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
# Embeddings for recall and deduplication. Changing the model later means re-embedding.
EMBEDDING_MODEL=bge-m3
# Turns conversations into notes and writes the nightly summaries. EXTRACTION=off stores conversations only.
EXTRACTION_MODEL=qwen3:8b
REFLECTION_MODEL=
EXTRACTION=on
EXTRACTION_DAILY_LIMIT=200
# Standing orders: rules checked against agents' tool calls (docs/standing-orders.md). Off unless "on".
STANDING_ORDERS=off
# Optional reranker with a /rerank endpoint (llama.cpp --reranking, vLLM, TEI, Infinity). Without it recall keeps its fused order.
AI_RERANK_URL=
RERANK_MODEL=

# Or use Workers AI over its REST API with the same models as the Worker:
# AI_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=        # token with "Workers AI: Read"
# EMBEDDING_MODEL=             # leave empty for the Worker's defaults

# --- admin API (/v1/admin): any long random string, e.g. openssl rand -hex 32
ADMIN_TOKEN=

# --- sign-in for the memory explorer and the OAuth consent page
# password: built-in sign-in for one person. The person is created on first sign-in.
AUTH_MODE=password
LOGIN_EMAIL=you@example.com
LOGIN_PASSWORD=
# At least 32 characters, e.g. openssl rand -hex 32
SESSION_SECRET=

# Sign-in attempts per client address and minute.
LOGIN_RATE_LIMIT=10
# Changing LOGIN_EMAIL, LOGIN_PASSWORD or SESSION_SECRET signs every session out.

# proxy: a sign-in proxy in front of rhizome (Authelia, oauth2-proxy, Tailscale Serve, ...) passes the email.
# rhizome must be able to tell the request came through the proxy: set one of the two below.
# AUTH_MODE=proxy
# PROXY_AUTH_HEADER=Remote-Email
# PROXY_AUTH_SECRET=          # 32+ characters; the proxy sends it as x-rhizome-proxy-secret
# PROXY_TRUSTED_IPS=          # or: addresses/IPv4 ranges the proxy connects from, e.g. 127.0.0.1,::1,172.18.0.0/16
# SESSION_SECRET=

# access: Cloudflare Access in front (also works on Node, e.g. through Cloudflare Tunnel).
# AUTH_MODE=access
# ACCESS_AUD=
# ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com

# --- optional: operator details for /imprint and /privacy (both pages answer 404 without them)
OPERATOR_NAME=
OPERATOR_BUSINESS=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_COUNTRY_EN=
OPERATOR_COUNTRY_DE=
OPERATOR_EMAIL=
OPERATOR_PHONE=
SUPERVISORY_AUTHORITY=
