# Copy to .env.deploy (not committed) or set these as build variables in Workers Builds.
RHIZOME_HOSTNAME=memory.example.com
RHIZOME_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# Optional: memory explorer behind Cloudflare Access (application audience tag and team domain).
ACCESS_AUD=
ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com

# Optional, instead of Access: built-in sign-in for one person. Also set the secrets
# LOGIN_PASSWORD and SESSION_SECRET (wrangler secret put ...).
AUTH_MODE=
LOGIN_EMAIL=

# Optional: operator details for /imprint and /privacy (both pages answer 404 without them).
OPERATOR_NAME=
OPERATOR_BUSINESS=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_COUNTRY_EN=
OPERATOR_COUNTRY_DE=
OPERATOR_EMAIL=
OPERATOR_PHONE=
SUPERVISORY_AUTHORITY=

# Optional: anonymous MCP usage analytics to PostHog ("on" to enable). Also set the
# secret POSTHOG_KEY (wrangler secret put POSTHOG_KEY).
MCP_ANALYTICS=
POSTHOG_HOST=https://eu.i.posthog.com
