// Template. Values written as <PLACEHOLDER> are filled from environment variables by
// scripts/render-config.mjs, which writes wrangler.deploy.jsonc (not committed).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhizome",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "<RHIZOME_HOSTNAME>", "custom_domain": true }],
  "observability": { "enabled": true },
  // The memory explorer (web/). The Worker runs first for everything but the hashed bundles,
  // so the page itself gets a per-request CSP nonce (see withScriptNonce in src/index.ts).
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Nightly reflection (consolidation, decay, profile distillation) at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ACCESS_AUD": "<ACCESS_AUD?>",
    "ACCESS_TEAM_DOMAIN": "<ACCESS_TEAM_DOMAIN?>",
    "AUTH_MODE": "<AUTH_MODE?>",
    "LOGIN_EMAIL": "<LOGIN_EMAIL?>",
    "OPERATOR_NAME": "<OPERATOR_NAME?>",
    "OPERATOR_BUSINESS": "<OPERATOR_BUSINESS?>",
    "OPERATOR_STREET": "<OPERATOR_STREET?>",
    "OPERATOR_CITY": "<OPERATOR_CITY?>",
    "OPERATOR_COUNTRY_EN": "<OPERATOR_COUNTRY_EN?>",
    "OPERATOR_COUNTRY_DE": "<OPERATOR_COUNTRY_DE?>",
    "OPERATOR_EMAIL": "<OPERATOR_EMAIL?>",
    "OPERATOR_PHONE": "<OPERATOR_PHONE?>",
    "SUPERVISORY_AUTHORITY": "<SUPERVISORY_AUTHORITY?>",
    // Every optional recall step on (see README), and conversations cut into rounds.
    "RECALL_FEATURES": "all",
    "CHUNKING": "rounds",
    // Nightly reflection settles disputed notes by trust and time (see README).
    "DISPUTE_RESOLUTION": "on",
    // Anonymous MCP usage analytics to PostHog, off unless MCP_ANALYTICS is "on" (see README).
    "MCP_ANALYTICS": "<MCP_ANALYTICS?>",
    "POSTHOG_HOST": "<POSTHOG_HOST?>",
    // Feature flags from PostHog, off unless POSTHOG_FLAGS is "on" (src/flags.ts).
    "POSTHOG_FLAGS": "<POSTHOG_FLAGS?>"
  },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "MEMORY", "class_name": "MemoryObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MemoryObject"] }],
  "d1_databases": [
    { "binding": "CONTROL_DB", "database_name": "rhizome-control", "database_id": "<RHIZOME_D1_DATABASE_ID>", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "EPISODES", "bucket_name": "rhizome-episodes" }],
  "vectorize": [{ "binding": "VECTORS", "index_name": "rhizome-memory" }],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 120, "period": 60 } },
    // Sign-in attempts per client address with AUTH_MODE=password.
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "4202", "simple": { "limit": 10, "period": 60 } }
  ]
  // Secret: ADMIN_TOKEN (wrangler secret put ADMIN_TOKEN). Enables the /v1/admin endpoints.
  // Secret: POSTHOG_KEY (wrangler secret put POSTHOG_KEY), the PostHog project API key for MCP_ANALYTICS.
  // Sign-in without Cloudflare Access: AUTH_MODE=password with LOGIN_EMAIL, plus the secrets LOGIN_PASSWORD and SESSION_SECRET.
  // Optional vars: EMBEDDING_MODEL, RERANK_MODEL, EXTRACTION_MODEL, REFLECTION_MODEL, EXTRACTION ("off"), EXTRACTION_DAILY_LIMIT, DISPUTE_RESOLUTION ("off" turns it off; on by default).
  // Optional var OPEN_LOOPS ("off"): open loops with a due date, shown under Due now in get_context. On by default.
  // Optional var STANDING_ORDERS ("off"): rules checked against agents' tool calls, see docs/standing-orders.md. On by default.
  // Optional var LEDGER ("off"): tells connectors when a memory they were given is replaced. On by default.
  // Optional var RECORDS ("off"): every note filed as a typed row for the recall step "records" and query_records. On by default. RECORDS_MODEL picks the model.
  // Optional var VECTOR_FILTERS ("on"): recall in a time window also filters Vectorize by event day. Needs the metadata index "day" (number, see README).
  // LEDGER, OPEN_LOOPS, STANDING_ORDERS, DISPUTE_RESOLUTION and RECORDS, when unset, follow PostHog flags with POSTHOG_FLAGS=on (src/flags.ts).
  // Placeholders ending in "?" are optional and become empty strings when unset.
}
