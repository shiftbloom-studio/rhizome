// The benchmark Worker (bench/worker.ts, see bench/README.md). It has no route: runs are
// started and read through the Cloudflare API. Its bucket and index hold benchmark data only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhizome-bench",
  "main": "bench/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Splitting the dataset (a few hundred megabytes of JSON) takes seconds of CPU.
  "limits": { "cpu_ms": 300000 },
  "vars": {
    // As deployed (wrangler.jsonc); test/bench-cloudflare.test.ts keeps them equal.
    "RECALL_FEATURES": "all",
    "CHUNKING": "rounds",
    "DISPUTE_RESOLUTION": "on",
    // A run turns extraction on with the param "extraction".
    "EXTRACTION": "off",
    // Agent-facing features (on by default when deployed) stay off, so runs stay comparable.
    "LEDGER": "off",
    "OPEN_LOOPS": "off",
    "STANDING_ORDERS": "off"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "MEMORY", "class_name": "BenchMemory" },
      { "name": "AI_GATE", "class_name": "AiGate" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BenchMemory", "AiGate"] }],
  "workflows": [{ "name": "rhizome-bench", "binding": "RUNS", "class_name": "BenchWorkflow" }],
  "r2_buckets": [
    { "binding": "BENCH", "bucket_name": "rhizome-bench" },
    { "binding": "EPISODES", "bucket_name": "rhizome-bench" }
  ],
  // 1,024 dimensions (bge-m3), cosine, with metadata indexes on scope and kind, like the deployed index.
  "vectorize": [{ "binding": "VECTORS", "index_name": "rhizome-bench" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
